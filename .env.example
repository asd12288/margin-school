# ─────────────────────────────────────────────────────────────
# Template. Copy to .env.local for local development:
#
#   npm run db:start        # start the local Docker stack
#   supabase status -o env  # read the local values
#
# .env.local is generated and git-ignored. Never commit real values.
# See docs/environments.md for which environment points where.
# ─────────────────────────────────────────────────────────────

# --- Supabase -------------------------------------------------
# Local:      http://127.0.0.1:54321
# Preview:    the staging project
# Production: the Paris production project
NEXT_PUBLIC_SUPABASE_URL=

# Safe to expose to the browser. Replaces the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Bypasses row-level security.
# Never prefix with NEXT_PUBLIC_. Never commit. Never send to the browser.
SUPABASE_SECRET_KEY=

# --- Database -------------------------------------------------
# Local only. Drizzle reads DATABASE_URL ?? POSTGRES_URL, and on Vercel the
# Supabase integration already supplies POSTGRES_URL (pooled) — so do NOT add
# a DATABASE_URL there. See docs/environments.md.
# Local value: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# --- App ------------------------------------------------------
# local | preview | production
NEXT_PUBLIC_APP_ENV=local

# --- Google sign-in (required) --------------------------------
# Not optional any more. `supabase/config.toml` now ships with
# `[auth.external.google] enabled = true`, and that field is a literal the CLI
# parses before env substitution — so the bottom two must be present or
# `supabase start` comes up with an empty client id and a Google button that
# fails on click. If you are working on this repo without Google credentials,
# set `enabled = false` in config.toml rather than leaving these blank.
#
# The first is read by the app (hence NEXT_PUBLIC_) and only decides whether the
# button is drawn; the other two are read by config.toml and never reach the
# Next process. Vercel therefore holds the flag alone — no Google secret is
# stored there, because the credentials live in Supabase, not in the app.
#
# The client id is not a secret (it travels in the OAuth URL). The secret is,
# and Google will not show you an existing one — if it is lost, add a new
# secret on the client in Google Cloud and replace it in both places that hold
# it: your .env.local, and the hosted project via `supabase config push`.
#
# Google Cloud project `margin-school` → Clients → "Supabase Auth (local +
# preview + production)". See docs/environments.md for the whole picture.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Local tooling (local only) -------------------------------
# Studio: http://127.0.0.1:54323   Mailpit (auth emails): http://127.0.0.1:54324
SUPABASE_STUDIO_URL=
SUPABASE_MAILPIT_URL=

# --- Added in later phases ------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RESEND_API_KEY=
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
