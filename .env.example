# ─────────────────────────────────────────────────────────────
# Template. Copy to .env.local for local development:
#
#   npm run db:start        # start the local Docker stack
#   supabase status -o env  # read the local values
#
# .env.local is generated and git-ignored. Never commit real values.
# See docs/environments.md for which environment points where.
# ─────────────────────────────────────────────────────────────

# --- Supabase -------------------------------------------------
# Local:      http://127.0.0.1:54321
# Preview:    the staging project
# Production: the Paris production project
NEXT_PUBLIC_SUPABASE_URL=

# Safe to expose to the browser. Replaces the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Bypasses row-level security.
# Never prefix with NEXT_PUBLIC_. Never commit. Never send to the browser.
SUPABASE_SECRET_KEY=

# --- Database -------------------------------------------------
# Local only. Drizzle reads DATABASE_URL ?? POSTGRES_URL, and on Vercel the
# Supabase integration already supplies POSTGRES_URL (pooled) — so do NOT add
# a DATABASE_URL there. See docs/environments.md.
# Local value: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# --- App ------------------------------------------------------
# local | preview | production
NEXT_PUBLIC_APP_ENV=local

# --- Google sign-in -------------------------------------------
# Both lines are commented out on purpose, and uncommenting them is a pair —
# neither one alone leaves you anywhere good.
#
# The client id is not here at all: it is public, so it is committed as a
# literal in supabase/config.toml. Only the secret is a secret.
#
# Uncomment BOTH and paste the secret to work on Google sign-in locally:
#   - NEXT_PUBLIC_AUTH_GOOGLE_ENABLED draws the button (read by the app).
#   - SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET is read by config.toml when the
#     local stack starts, and never reaches the Next process.
#
# Uncomment only the flag and you get a button that dies at the token exchange.
# Leave both commented and the app runs on email and password, which is why
# that is the default here.
#
# Google will not show you an existing client secret. If it is lost, add a new
# one in Google Cloud → project `margin-school` → Clients → "Supabase Auth
# (local + preview + production)", then update your .env.local. Production's
# copy is set on the Supabase project itself and is deliberately NOT managed by
# this repo — see the [remotes.production.auth.external.google] block.
# NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Local tooling (local only) -------------------------------
# Studio: http://127.0.0.1:54323   Mailpit (auth emails): http://127.0.0.1:54324
SUPABASE_STUDIO_URL=
SUPABASE_MAILPIT_URL=

# --- Added in later phases ------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RESEND_API_KEY=
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
